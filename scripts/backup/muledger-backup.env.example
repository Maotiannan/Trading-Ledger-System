# Copy this file to ~/.muledger-backup/muledger-backup.env or .env.muledger-backup.local.
# Never commit the real file. Keep the Tencent Cloud key limited to the backup bucket only.

COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

COS_BUCKET=muledger-backup-prod-1318783232
COS_ALIAS=muledger-backup-prod
COS_REGION=ap-shanghai
COS_ENDPOINT=cos.ap-shanghai.myqcloud.com

COS_DB_PREFIX=database/mysql
COS_MEDIA_PREFIX=media/upload
COS_MANIFEST_PREFIX=manifests

DATABASE_URL=mysql://muledger:replace-with-your-password@192.168.1.3:3306/trading_ledger
UPLOAD_HOST_DIR=/Volumes/团队文件-DAINTY_SHIPMENT/docker/trading-ledger-system/upload

# Optional overrides.
# COSCLI_BIN=coscli
# MYSQLDUMP_BIN=auto
# The production database is MariaDB-compatible. Keep the client close to the server major version.
# MYSQLDUMP_DOCKER_IMAGE=mariadb:10.6
# MULEDGER_BACKUP_HOME=/Users/maotiannan/.muledger-backup
# LOCAL_RETENTION_DAYS=14
