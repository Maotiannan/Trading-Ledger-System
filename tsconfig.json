{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-api-isolated/types/**/*.ts",
    ".next-api-isolated/dev/types/**/*.ts",
    ".next-e2e-isolated/types/**/*.ts",
    ".next-e2e-isolated/dev/types/**/*.ts",
    ".next-reliability-isolated/types/**/*.ts",
    ".next-reliability-isolated/dev/types/**/*.ts",
    ".next-invoice-r2/types/**/*.ts",
    ".next-invoice-r2/dev/types/**/*.ts",
    ".next-prepayment-isolated/types/**/*.ts",
    ".next-prepayment-isolated/dev/types/**/*.ts",
    ".next-invoice-ui-236/types/**/*.ts",
    ".next-invoice-ui-236/dev/types/**/*.ts",
    ".next-237-isolated/types/**/*.ts",
    ".next-237-isolated/dev/types/**/*.ts",
    ".next-240-isolated/types/**/*.ts",
    ".next-240-isolated/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "examples/websocket"
  ]
}
