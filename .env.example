# Local direct run (outside Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trading_ledger?schema=public"

# Docker Compose Postgres bootstrap
POSTGRES_DB="trading_ledger"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Required in production (at least 32 characters)
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional admin init route (disabled by default)
ENABLE_INIT_ROUTE="false"
INIT_ADMIN_TOKEN="replace-init-token"
INIT_ADMIN_EMAIL="admin@example.com"
INIT_ADMIN_PASSWORD="replace-strong-password"

# OCR resilience and cost logging
OCR_DISABLED="false"
OCR_API_BASE_URL="https://api.openai.com/v1"
OCR_API_KEY="replace-with-your-ocr-api-key"
OCR_MODEL="gpt-4o-mini"
OCR_MAX_RETRIES="3"
OCR_TIMEOUT_MS="15000"
OCR_RETRY_BASE_DELAY_MS="1200"
OCR_INPUT_COST_PER_1K="0"
OCR_OUTPUT_COST_PER_1K="0"
