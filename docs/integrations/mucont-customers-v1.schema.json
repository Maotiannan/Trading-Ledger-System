{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://muledger.dainty.vip/contracts/mucont-customers-v1.schema.json",
  "title": "MU Ledger mucont customer identity v1",
  "$comment": "GET /api/integrations/mucont/v1/customers/options?q=&limit=20&cursor=...; GET /api/integrations/mucont/v1/customers/{customerId}. Authorization: Bearer MUCONT_CUSTOMERS_READ_TOKEN (server-only, all customers, read-only). All responses: Cache-Control: no-store. Sort: customerId ascending. q: NFKC, trim, collapse whitespace, lowercase; max 200 characters. limit: integer 1..50, default 20; values above 50 capped. Cursor is opaque, signed and bound to normalized q and sort. Empty q lists first batch. Never select identity by display values. Options search name/companyName/mark/orderName/aliases using case-insensitive contains, plus normalized MARK/ORDER NAME matching. Details use a repeatable-read committed snapshot. No owner filtering. No success wrapper.",
  "oneOf": [
    { "$ref": "#/definitions/OptionsResponse" },
    { "$ref": "#/definitions/DetailResponse" },
    { "$ref": "#/definitions/ErrorResponse" }
  ],
  "definitions": {
    "NullableText": { "type": ["string", "null"] },
    "CustomerOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId", "mark", "name", "companyName"],
      "properties": {
        "customerId": { "type": "string", "minLength": 1 },
        "mark": { "$ref": "#/definitions/NullableText" },
        "name": { "$ref": "#/definitions/NullableText" },
        "companyName": { "$ref": "#/definitions/NullableText" }
      }
    },
    "OptionsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor", "hasMore"],
      "properties": {
        "items": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/CustomerOption" } },
        "nextCursor": { "type": ["string", "null"], "minLength": 1 },
        "hasMore": { "type": "boolean" }
      },
      "if": { "properties": { "hasMore": { "const": false } } },
      "then": { "properties": { "nextCursor": { "type": "null" } } },
      "else": { "properties": { "nextCursor": { "type": "string", "minLength": 1 }, "items": { "minItems": 1 } } }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "companyName", "companyAddress", "phone", "city", "mark", "orderNames", "consignee", "consignees"],
      "properties": {
        "name": { "$ref": "#/definitions/NullableText" },
        "companyName": { "$ref": "#/definitions/NullableText" },
        "companyAddress": { "$ref": "#/definitions/NullableText" },
        "phone": { "$ref": "#/definitions/NullableText" },
        "city": { "$ref": "#/definitions/NullableText" },
        "mark": { "$ref": "#/definitions/NullableText" },
        "orderNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "consignee": { "$ref": "#/definitions/NullableText" },
        "consignees": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "DetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customerId", "capturedAt", "completeness", "profile"],
      "properties": {
        "customerId": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "completeness": { "const": "MASTER_FULL" },
        "profile": { "$ref": "#/definitions/Profile" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "enum": ["AUTH_REQUIRED", "AUTH_INVALID", "INVALID_QUERY", "INVALID_CURSOR", "CUSTOMER_NOT_FOUND", "RATE_LIMITED", "SERVICE_UNAVAILABLE"] },
            "message": { "type": "string", "minLength": 1 },
            "customerId": { "type": "string" },
            "retryAfterMs": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
