{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muledger.local/schemas/mu-contract-order-sync-v1.schema.json",
  "title": "MU Contract to MULEDGER Order Sync Version 1",
  "$defs": {
    "cursor": {
      "type": "string",
      "maxLength": 19,
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "piId", "version"],
      "properties": {
        "system": { "const": "MU_CONTRACT" },
        "piId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)$"
        },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderNo", "previousOrderNo", "piCreatedAt", "active", "deletedAt"],
      "properties": {
        "orderNo": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "\\S" },
        "previousOrderNo": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "\\S" }
          ]
        },
        "piCreatedAt": { "$ref": "#/$defs/utcTimestamp" },
        "active": { "type": "boolean" },
        "deletedAt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/utcTimestamp" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "active": { "const": true },
            "deletedAt": { "type": "null" }
          }
        },
        {
          "properties": {
            "active": { "const": false },
            "deletedAt": { "$ref": "#/$defs/utcTimestamp" }
          }
        }
      ]
    },
    "officialAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "value", "generatedAt", "generationRunId"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "value": {
          "type": "string",
          "maxLength": 19,
          "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
        },
        "generatedAt": { "$ref": "#/$defs/utcTimestamp" },
        "generationRunId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" }
      }
    },
    "snapshotItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "order", "officialAmount"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "order": {
          "allOf": [
            { "$ref": "#/$defs/order" },
            {
              "type": "object",
              "properties": {
                "previousOrderNo": { "type": "null" }
              }
            }
          ]
        },
        "officialAmount": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/officialAmount" }
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "eventId",
        "eventType",
        "reason",
        "occurredAt",
        "source",
        "order",
        "officialAmount"
      ],
      "properties": {
        "cursor": { "$ref": "#/$defs/cursor" },
        "eventId": { "type": "string", "format": "uuid" },
        "eventType": {
          "enum": ["PI_ORDER_LINKED", "PI_ORDER_RENAMED", "PI_FORMAL_PDF_GENERATED", "PI_SOURCE_DEACTIVATED"]
        },
        "reason": {
          "enum": ["ORDER_ASSIGNED", "ORDER_CHANGED", "FORMAL_PDF_GENERATED", "FORMAL_PDF_REGENERATED", "PI_DELETED", "ORDER_UNLINKED"]
        },
        "occurredAt": { "$ref": "#/$defs/utcTimestamp" },
        "source": { "$ref": "#/$defs/source" },
        "order": { "$ref": "#/$defs/order" },
        "officialAmount": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/officialAmount" }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "eventType": { "const": "PI_ORDER_LINKED" },
            "reason": { "const": "ORDER_ASSIGNED" },
            "order": {
              "type": "object",
              "properties": {
                "active": { "const": true },
                "previousOrderNo": { "type": "null" }
              }
            }
          }
        },
        {
          "properties": {
            "eventType": { "const": "PI_ORDER_RENAMED" },
            "reason": { "const": "ORDER_CHANGED" },
            "order": {
              "type": "object",
              "properties": {
                "active": { "const": true },
                "previousOrderNo": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "eventType": { "const": "PI_FORMAL_PDF_GENERATED" },
            "reason": {
              "enum": ["FORMAL_PDF_GENERATED", "FORMAL_PDF_REGENERATED"]
            },
            "order": {
              "type": "object",
              "properties": {
                "active": { "const": true },
                "previousOrderNo": { "type": "null" }
              }
            },
            "officialAmount": { "$ref": "#/$defs/officialAmount" }
          }
        },
        {
          "properties": {
            "eventType": { "const": "PI_SOURCE_DEACTIVATED" },
            "reason": { "enum": ["PI_DELETED", "ORDER_UNLINKED"] },
            "order": {
              "type": "object",
              "properties": {
                "active": { "const": false },
                "previousOrderNo": { "type": "null" }
              }
            }
          }
        }
      ]
    },
    "eventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "events", "nextCursor", "hasMore"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "events": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/event" } },
        "nextCursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/cursor" }
          ]
        },
        "hasMore": { "type": "boolean" }
      }
    },
    "snapshotPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "items", "eventHighWatermark", "nextAfter", "hasMore"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/snapshotItem" } },
        "eventHighWatermark": { "$ref": "#/$defs/cursor" },
        "nextAfter": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
            }
          ]
        },
        "hasMore": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/eventPage" },
    { "$ref": "#/$defs/snapshotPage" }
  ]
}
