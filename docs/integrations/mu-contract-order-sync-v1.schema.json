{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muledger.local/schemas/mu-contract-order-sync-v1.schema.json",
  "title": "MU Contract to MULEDGER Order Sync Version 1",
  "$defs": {
    "cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "piId", "version"],
      "properties": {
        "system": { "const": "MU_CONTRACT" },
        "piId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderNo", "previousOrderNo", "piCreatedAt", "active", "deletedAt"],
      "properties": {
        "orderNo": { "type": "string", "minLength": 1, "maxLength": 191 },
        "previousOrderNo": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 191 }
          ]
        },
        "piCreatedAt": { "$ref": "#/$defs/utcTimestamp" },
        "active": { "type": "boolean" },
        "deletedAt": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/utcTimestamp" }
          ]
        }
      }
    },
    "officialAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "value", "generatedAt", "generationRunId"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "value": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "generatedAt": { "$ref": "#/$defs/utcTimestamp" },
        "generationRunId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "snapshotItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "order", "officialAmount"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "order": { "$ref": "#/$defs/order" },
        "officialAmount": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/officialAmount" }
          ]
        }
      }
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/snapshotItem" },
        {
          "type": "object",
          "required": ["cursor", "eventId", "eventType", "reason", "occurredAt"],
          "properties": {
            "cursor": { "$ref": "#/$defs/cursor" },
            "eventId": { "type": "string", "format": "uuid" },
            "eventType": {
              "enum": ["PI_ORDER_LINKED", "PI_ORDER_RENAMED", "PI_FORMAL_PDF_GENERATED", "PI_SOURCE_DEACTIVATED"]
            },
            "reason": {
              "enum": ["ORDER_ASSIGNED", "ORDER_CHANGED", "FORMAL_PDF_GENERATED", "FORMAL_PDF_REGENERATED", "PI_DELETED", "ORDER_UNLINKED"]
            },
            "occurredAt": { "$ref": "#/$defs/utcTimestamp" }
          }
        }
      ]
    },
    "eventPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "events", "nextCursor", "hasMore"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "events": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/event" } },
        "nextCursor": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/cursor" }
          ]
        },
        "hasMore": { "type": "boolean" }
      }
    },
    "snapshotPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "items", "eventHighWatermark", "nextAfter", "hasMore"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/snapshotItem" } },
        "eventHighWatermark": { "$ref": "#/$defs/cursor" },
        "nextAfter": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 64 }
          ]
        },
        "hasMore": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/eventPage" },
    { "$ref": "#/$defs/snapshotPage" }
  ]
}
