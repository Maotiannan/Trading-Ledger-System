// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 用户角色枚举
enum UserRole {
  ADMIN
  SALES
  USER
}

enum SwiftStatus {
  Bank_Transfer
  RECEIVED
  ERROR
}

// 收据状态枚举
enum ReceiptStatus {
  SIGNING_PENDING // 签名中，未进入业务流程
  SR_Received    // 已收到收据
  Waiting_SWIFT  // 等待SWIFT
  Bank_Transfer  // 银行已转账
  RECEIVED       // 已签收
}

enum ReceiptGeneratorSessionStatus {
  PENDING
  FINALIZED
  CANCELLED
}

enum UploadedAssetStatus {
  STAGED
  ATTACHED
  DELETED
}

enum UploadedAssetAttachmentType {
  RECEIPT
  DETAIL
  SWIFT
  RECEIPT_GENERATOR_SESSION
  PAYMENT_AGENT_FILE
  CUSTOMER_FILE
}

enum UploadedAssetCategory {
  RECEIPT_DIRECT
  RECEIPT_OCR
  DETAIL_OCR
  SWIFT_OCR
  RECEIPT_GENERATOR_FINAL
  RECEIPT_GENERATOR_SIGNATURE
  AGENT_FILE
  CUSTOMER_FILE
}

// 付款明细状态枚举
enum DetailStatus {
  Waiting_SWIFT  // 等待SWIFT
  Bank_Transfer  // 银行已转账
  RECEIVED       // 已签收
  ERROR          // 金额不一致错误
}

enum DetailSourceMode {
  OCR
  DIRECT
}

enum ExternalOrderLinkMode {
  MANUAL_ATTACHED
  SYNC_CREATED
}

enum ExternalCustomerMatchStatus {
  MATCHED
  UNMATCHED
  CONFLICT
}

enum IntegrationEventResult {
  APPLIED
  IGNORED_STALE
  BUSINESS_CONFLICT
}

enum IntegrationConflictType {
  INVALID_SOURCE_DATA
  ORDER_NO_COLLISION
  SOURCE_LINK_COLLISION
  HUMAN_EDITED_RENAME_COLLISION
  CUSTOMER_MATCH_CONFLICT
  UNSUPPORTED_CURRENCY
}

enum IntegrationConflictStatus {
  OPEN
  RESOLVED
}

enum IntegrationReconcileStatus {
  IDLE
  RUNNING
  FAILED
  COMPLETED
}

// 删除申请状态枚举
enum DeletionStatus {
  PENDING   // 待审批
  APPROVED  // 已批准
  REJECTED  // 已拒绝
}

enum ReceiptEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DetailEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SwiftEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CustomerEmailLanguage {
  ENGLISH
  FRENCH
}

enum EmailRecipientMode {
  PRIMARY_CC
  SEPARATE
}

enum EmailNotificationType {
  PAYMENT_RECEIVED
  SHIPMENT
  RELEASE
}

enum EmailNotificationStatus {
  MISSING_RECIPIENT
  PENDING
  QUEUED
  SENDING
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  PARTIALLY_SENT
  FAILED
  DELIVERY_UNCERTAIN
  CANCELLED
  NEEDS_CORRECTION
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
  DELIVERY_UNCERTAIN
  CANCELLED
}

enum EmailAttemptStatus {
  STARTED
  ACCEPTED
  REJECTED
  UNCERTAIN
}

// 删除目标类型枚举
enum DeletionTargetType {
  RECEIPT
  DETAIL
  SWIFT
}

// ==================== 用户表 ====================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String?
  role         UserRole @default(USER)
  level        Int      @default(4)
  parentId     String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 关联
  parent            User?             @relation("UserParent", fields: [parentId], references: [id], onDelete: SetNull)
  children          User[]            @relation("UserParent")
  createdBy         User?            @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]           @relation("UserCreatedBy")
  invoices          Invoice[]
  orders            Order[]
  receipts          Receipt[]
  receiptHistories  ReceiptHistory[]
  details           Detail[]
  detailHistories   DetailHistory[]
  swifts            Swift[]
  createdCustomers  Customer[]        @relation("CustomerCreatedBy")
  ownedCustomers    Customer[]        @relation("CustomerOwner")
  deletionRequests  DeletionRequest[]
  deletionApprovals DeletionRequest[] @relation("ApprovedBy")
  auditLogs         AuditLog[]
  systemSettings    SystemSetting[]   @relation("SystemSettingUpdatedBy")
  receiptGeneratorSessions ReceiptGeneratorSession[] @relation("ReceiptGeneratorSessionCreatedBy")
  uploadedAssets   UploadedAsset[]
  excelApiTokens    ExcelApiToken[]
  preference       UserPreference?
  requestedReceiptEditRequests ReceiptEditRequest[] @relation("ReceiptEditRequester")
  approvedReceiptEditRequests  ReceiptEditRequest[] @relation("ReceiptEditApprover")
  requestedDetailEditRequests  DetailEditRequest[]  @relation("DetailEditRequester")
  approvedDetailEditRequests   DetailEditRequest[]  @relation("DetailEditApprover")
  requestedSwiftEditRequests   SwiftEditRequest[]   @relation("SwiftEditRequester")
  approvedSwiftEditRequests    SwiftEditRequest[]   @relation("SwiftEditApprover")
  paymentAgents                PaymentAgent[]       @relation("PaymentAgentCreatedBy")
  paymentAgentFiles            PaymentAgentFile[]   @relation("PaymentAgentFileUploadedBy")
  orderTrackers                OrderTracker[]       @relation("OrderTrackerCreatedBy")
  updatedOrderTrackers         OrderTracker[]       @relation("OrderTrackerUpdatedBy")
  externalOrderSourceEdits     ExternalOrderSourceLink[]     @relation("ExternalOrderSourceHumanEditor")
  integrationSyncStates        IntegrationSyncState[]        @relation("IntegrationSyncServiceActor")
  resolvedIntegrationConflicts IntegrationSyncConflict[]     @relation("IntegrationConflictResolver")
  integrationReconcilePreviews IntegrationReconcilePreview[] @relation("IntegrationReconcilePreviewCreator")
  createdCustomerNotificationEmails CustomerNotificationEmail[] @relation("CustomerNotificationEmailCreatedBy")
  updatedCustomerNotificationEmails CustomerNotificationEmail[] @relation("CustomerNotificationEmailUpdatedBy")
  createdEmailTemplates             EmailTemplate[]             @relation("EmailTemplateCreatedBy")
  sourcedEmailNotifications         EmailNotification[]         @relation("EmailNotificationSourceActor")
  approvedEmailNotifications        EmailNotification[]         @relation("EmailNotificationApprover")
  cancelledEmailNotifications       EmailNotification[]         @relation("EmailNotificationCanceller")

  @@index([parentId])
  @@index([createdById])
  @@index([level])
}

model UserPreference {
  userId                        String
  imageCompressionEnabled       Boolean  @default(true)
  imageCompressionQualityFloor  Decimal  @default(0.30) @db.Decimal(3, 2)
  ocrTargetMaxKb                Int      @default(500)
  dashboardLayout               Json?
  listPageSizes                 Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId])
}

model ExcelApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String    @default("Excel ML")
  tokenPrefix String    @unique @map("token_prefix")
  tokenHash   String    @map("token_hash")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  revokedAt   DateTime? @map("revoked_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([lastUsedAt])
}

model UploadedAsset {
  id           String                       @id @default(cuid())
  path         String                       @db.LongText
  name         String                       @db.Text
  category     UploadedAssetCategory
  mimeType     String
  sizeBytes    Int
  createdBy    String
  status       UploadedAssetStatus          @default(STAGED)
  attachedType UploadedAssetAttachmentType?
  attachedId   String?
  expiresAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([path(length: 255)])
  @@index([status, expiresAt])
  @@index([attachedType, attachedId])
  @@index([category, createdAt])
  @@index([createdBy, createdAt])
}

// ==================== 账单表 (Invoice) ====================
model Invoice {
  id        String   @id @default(cuid())
  invNo     String   @unique // INV NO 账单号
  createdBy String
  shipDate  DateTime?
  releaseDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  orders  Order[]
  creator User @relation(fields: [createdBy], references: [id])
  emailNotifications EmailNotification[]

  @@index([invNo])
}

// ==================== 订单表 (Order) ====================
model Order {
  id            String   @id @default(cuid())
  invoiceId     String
  orderNo       String   // ORDER 客户单号
  tokens        String   @default("[]") @db.Text // 分词结果，JSON格式存储数组
  amount        Decimal  @db.Decimal(18, 2) // AMOUNT 单个ORDER总金额
  orderBalance  Decimal  @default(0) @db.Decimal(18, 2) // ORDER BALANCE 未付金额
  createdBy     String?
  customerId    String?
  customerMark  String?
  customerName  String?
  customerPhone String?
  customerCity  String?
  needsCustomerFix Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 关联
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator         User?            @relation(fields: [createdBy], references: [id])
  receipts        Receipt[]        @relation("ReceiptOrder")
  mergedReceipts  Receipt[]        @relation("MergedTo")
  aliases         OrderAlias[]
  orderTrackers   OrderTracker[]     @relation("OrderTrackerFinanceOrder")
  balanceTransfersFrom BalanceTransfer[] @relation("TransferFrom")
  balanceTransfersTo   BalanceTransfer[] @relation("TransferTo")

  @@index([invoiceId])
  @@index([createdBy])
  @@index([orderNo])
  @@unique([invoiceId, orderNo])
}

model OrderAlias {
  id        String   @id @default(cuid())
  orderId   String
  aliasNo   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([aliasNo])
  @@index([orderId])
}

// ==================== 业务订单跟踪表 (Orders 页面独立使用，不参与财务订单匹配) ====================
model OrderTracker {
  id                String   @id @default(cuid())
  orderNo           String
  normalizedOrderNo String   @unique
  tokens            String   @default("[]") @db.Text
  amount            Decimal  @default(0) @db.Decimal(18, 2)
  orderBalance      Decimal  @default(0) @db.Decimal(18, 2)
  financeOrderId    String?
  createdBy         String
  updatedBy         String?
  customerId        String?
  customerMark      String?
  customerName      String?
  customerPhone     String?
  customerCity      String?
  needsCustomerFix  Boolean  @default(false)
  status            String   @default("In progress")
  confirmedAt       DateTime?
  piStatus          Boolean  @default(false)
  remark            String?  @db.Text
  systemNote        String?  @db.Text
  archivedAt        DateTime?
  archiveReason     String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator  User      @relation("OrderTrackerCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updater  User?     @relation("OrderTrackerUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  financeOrder Order? @relation("OrderTrackerFinanceOrder", fields: [financeOrderId], references: [id], onDelete: SetNull)
  externalSourceLinks       ExternalOrderSourceLink[]
  integrationEventReceipts IntegrationEventReceipt[]

  @@index([financeOrderId])
  @@index([createdBy])
  @@index([updatedBy])
  @@index([customerId])
  @@index([status])
  @@index([orderNo])
  @@index([normalizedOrderNo])
  @@index([archivedAt])
}

model ExternalOrderSourceLink {
  id                      String                      @id @default(cuid())
  provider                String
  externalId              String
  orderTrackerId          String?
  sourceVersion           Int
  sourceOrderNo           String
  normalizedSourceOrderNo String
  piCreatedAt             DateTime
  officialAmount          Decimal?                    @db.Decimal(18, 2)
  currency                String?
  officialGeneratedAt     DateTime?
  officialGenerationRunId String?
  active                  Boolean                     @default(true)
  sourceDeletedAt         DateTime?
  linkMode                ExternalOrderLinkMode
  humanEditedAt           DateTime?
  humanEditedBy           String?
  customerMatchStatus     ExternalCustomerMatchStatus
  lastEventCursor         String?
  firstSeenAt             DateTime                    @default(now())
  lastSourceUpdatedAt     DateTime
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  orderTracker OrderTracker? @relation(fields: [orderTrackerId], references: [id], onDelete: SetNull)
  humanEditor  User?         @relation("ExternalOrderSourceHumanEditor", fields: [humanEditedBy], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@unique([provider, orderTrackerId])
  @@index([provider, active])
  @@index([customerMatchStatus])
  @@index([normalizedSourceOrderNo])
  @@index([humanEditedBy])
}

model IntegrationSyncState {
  provider                    String                     @id
  committedCursor             String?
  lastAttemptAt               DateTime?
  lastSuccessAt               DateTime?
  lastErrorCode               String?
  lastErrorMessage            String?                    @db.Text
  nextEligiblePollAt          DateTime?
  leaseOwner                  String?
  leaseExpiresAt              DateTime?
  reconcileStatus             IntegrationReconcileStatus @default(IDLE)
  reconcileCursor             String?
  reconcileHighWatermark      String?
  initialReconcileCompletedAt DateTime?
  serviceActorId              String
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  serviceActor User @relation("IntegrationSyncServiceActor", fields: [serviceActorId], references: [id], onDelete: Restrict)

  @@index([leaseExpiresAt])
  @@index([lastSuccessAt])
  @@index([serviceActorId])
}

model IntegrationEventReceipt {
  id             String                 @id @default(cuid())
  provider       String
  eventId        String
  cursor         String
  sourcePiId     String
  sourceVersion  Int
  payloadHash    String
  result         IntegrationEventResult
  orderTrackerId String?
  processedAt    DateTime
  createdAt      DateTime               @default(now())

  orderTracker OrderTracker? @relation(fields: [orderTrackerId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([provider, cursor])
  @@index([provider, sourcePiId, sourceVersion])
  @@index([orderTrackerId])
}

model IntegrationSyncConflict {
  id                    String                    @id @default(cuid())
  dedupeKey             String                    @unique
  provider              String
  sourcePiId            String
  sourceVersion         Int
  eventId               String?
  cursor                String?
  type                  IntegrationConflictType
  sourceOrderNo         String?
  targetOrderTrackerIds Json
  summary               String                    @db.Text
  evidence              Json
  status                IntegrationConflictStatus @default(OPEN)
  resolutionNote        String?                   @db.Text
  resolvedAt            DateTime?
  resolvedBy            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  resolver User? @relation("IntegrationConflictResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([provider, status])
  @@index([provider, sourcePiId])
  @@index([resolvedBy])
}

model IntegrationReconcilePreview {
  id                  String    @id @default(cuid())
  provider            String
  sourceHighWatermark String
  snapshotSummary     Json
  summaryHash         String
  createdBy           String
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  consumedAt          DateTime?

  creator User @relation("IntegrationReconcilePreviewCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([provider, expiresAt])
  @@index([createdBy])
}

// ==================== 收据表 (Receipt) ====================
model Receipt {
  id           String         @id @default(cuid())
  receiptNo    String?        @unique // 收据号 NO.
  date         DateTime?      // 时间
  tel          String?        // 电话 Tel
  usd          Decimal        @db.Decimal(18, 2) // 付款金额 USD
  invNo        String?        // 账单号 (L**MH开头)
  orderNo      String?        // 客户单号 ORDER
  payer        String?        @db.Text // 付款人 recu de M./Mme
  status       ReceiptStatus  @default(SR_Received)
  imageUrl     String?        @db.LongText // 图片路径
  imageName    String?        @db.Text // 图片原始名称
  isDeposit    Boolean        @default(false) // 是否为定金
  isMerged     Boolean        @default(false) // 是否已合并到正式账单
  mergedToId   String?        // 合并到的订单ID
  customerId   String?
  customerMark String?
  customerName String?
  customerPhone String?
  customerCity String?
  needsCustomerFix Boolean    @default(false)
  note         String?        @db.Text // 备注
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // 关联
  creator          User             @relation(fields: [createdBy], references: [id])
  histories        ReceiptHistory[]
  editRequests     ReceiptEditRequest[]
  detailItems      DetailItem[]
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mergedTo         Order?           @relation("MergedTo", fields: [mergedToId], references: [id], onDelete: SetNull)
  order            Order?           @relation("ReceiptOrder", fields: [orderId], references: [id])
  generatorSession ReceiptGeneratorSession?
  generatedByBalanceTransfer BalanceTransfer? @relation("BalanceTransferGeneratedReceipt")
  emailNotifications EmailNotification[]
  orderId          String?

  @@index([orderNo])
  @@index([invNo])
  @@index([status])
  @@index([createdBy])
}

// ==================== 收据历史版本表 ====================
model ReceiptHistory {
  id           String   @id @default(cuid())
  receiptId    String
  receiptNo    String?
  date         DateTime?
  tel          String?
  usd          Decimal        @db.Decimal(18, 2)
  invNo        String?
  orderNo      String?
  payer        String?   @db.Text
  imageUrl     String?   @db.LongText
  imageName    String?   @db.Text
  status       ReceiptStatus
  note         String?   @db.Text // 变更备注
  createdBy    String
  createdAt    DateTime @default(now())

  // 关联
  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])

  @@index([receiptId])
}

model ReceiptEditRequest {
  id             String                   @id @default(cuid())
  receiptId      String
  status         ReceiptEditRequestStatus @default(PENDING)
  requestedBy    String
  approvedBy     String?
  pendingReceiptId String?                @unique
  requestedAt    DateTime                 @default(now())
  reviewedAt     DateTime?
  beforeSnapshot Json
  afterSnapshot  Json
  reviewComment  String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  requester User    @relation("ReceiptEditRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  approver  User?   @relation("ReceiptEditApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([receiptId, status])
  @@index([requestedBy, status])
  @@index([approvedBy])
}

// ==================== 付款明细表 (Detail) ====================
model Detail {
  id           String        @id @default(cuid())
  date         DateTime?     // 明细创建时间
  status       DetailStatus  @default(Waiting_SWIFT)
  sourceMode   DetailSourceMode @default(OCR)
  imageUrl     String?       @db.LongText // 图片路径
  imageName    String?       @db.Text // 图片原始名称
  totalAmount  Decimal       @default(0) @db.Decimal(18, 2) // 总金额
  agentId      String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // 关联
  creator    User           @relation(fields: [createdBy], references: [id])
  agent      PaymentAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  items      DetailItem[]
  histories  DetailHistory[]
  swift      Swift?
  editRequests DetailEditRequest[]

  @@index([status])
  @@index([createdBy])
  @@index([agentId])
}

// ==================== 付款明细行项目表 ====================
model DetailItem {
  id         String   @id @default(cuid())
  detailId   String
  mark       String?  // 唛头
  orderNo    String?  // 单号
  amount     Decimal  @db.Decimal(18, 2) // 金额
  receiptId  String?  // 关联的Receipt
  note       String?  @db.Text // 备注
  createdAt  DateTime @default(now())

  // 关联
  detail  Detail   @relation(fields: [detailId], references: [id], onDelete: Cascade)
  receipt Receipt? @relation(fields: [receiptId], references: [id])

  @@index([detailId])
  @@index([orderNo])
  @@index([receiptId])
}

// ==================== 付款明细历史版本表 ====================
model DetailHistory {
  id         String   @id @default(cuid())
  detailId   String
  date       DateTime?
  items      String   @db.LongText // JSON格式存储DetailItem数组
  imageUrl   String?  @db.LongText
  imageName  String?  @db.Text
  status     DetailStatus
  note       String?  @db.Text // 变更备注
  createdBy  String
  createdAt  DateTime @default(now())

  // 关联
  detail  Detail @relation(fields: [detailId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])

  @@index([detailId])
}

// ==================== SWIFT水单表 ====================
model Swift {
  id             String   @id @default(cuid())
  detailId       String   @unique // 一张SWIFT对应一张DETAIL
  status         SwiftStatus @default(Bank_Transfer)
  amount         Decimal  @db.Decimal(18, 2) // 汇款金额
  date           DateTime? // 汇款日期
  senderName     String?  // 汇款人姓名
  senderAddress  String?  @db.Text // 汇款人地址
  receiverName   String?  // 收款人姓名
  receiverAccount String? // 收款人账号
  imageUrl       String?  @db.LongText // 图片路径
  imageName      String?  @db.Text // 图片原始名称
  hasError       Boolean  @default(false) // 是否有错误(金额不一致)
  errorMessage   String?  @db.Text // 错误信息
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  detail  Detail @relation(fields: [detailId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id])
  editRequests SwiftEditRequest[]

  @@index([detailId])
  @@index([status])
}

model DetailEditRequest {
  id              String                  @id @default(cuid())
  detailId        String
  status          DetailEditRequestStatus @default(PENDING)
  requestedBy     String
  approvedBy      String?
  pendingDetailId String?                 @unique
  requestedAt     DateTime                @default(now())
  reviewedAt      DateTime?
  beforeSnapshot  Json
  afterSnapshot   Json
  reviewComment   String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  detail    Detail @relation(fields: [detailId], references: [id], onDelete: Cascade)
  requester User   @relation("DetailEditRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  approver  User?  @relation("DetailEditApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([detailId, status])
  @@index([requestedBy, status])
  @@index([approvedBy])
}

model SwiftEditRequest {
  id             String                 @id @default(cuid())
  swiftId        String
  status         SwiftEditRequestStatus @default(PENDING)
  requestedBy    String
  approvedBy     String?
  pendingSwiftId String?                @unique
  requestedAt    DateTime               @default(now())
  reviewedAt     DateTime?
  beforeSnapshot Json
  afterSnapshot  Json
  reviewComment  String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  swift     Swift @relation(fields: [swiftId], references: [id], onDelete: Cascade)
  requester User  @relation("SwiftEditRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  approver  User? @relation("SwiftEditApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([swiftId, status])
  @@index([requestedBy, status])
  @@index([approvedBy])
}

model PaymentAgent {
  id             String             @id @default(cuid())
  companyName    String             @db.Text
  companyAddress String?            @db.Text
  contactName    String?            @db.Text
  contactPhone   String?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  creator User               @relation("PaymentAgentCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  files   PaymentAgentFile[]
  details Detail[]

  @@index([createdBy])
}

model PaymentAgentFile {
  id         String   @id @default(cuid())
  agentId     String
  name       String   @db.Text
  path       String   @db.LongText
  mimeType   String?
  size       Int?
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  agent    PaymentAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  uploader User         @relation("PaymentAgentFileUploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([uploadedBy])
}

// ==================== 客户表 ====================
model Customer {
  id             String   @id @default(cuid())
  mark           String
  normalizedMark String   @map("normalized_mark")
  orderName      String   @map("order_name")
  name           String   @db.Text
  phone          String
  city           String
  consignee      String?  @db.Text
  companyName    String?  @db.Text
  credit         Decimal? @db.Decimal(18, 2)
  companyAddress String?  @db.Text
  notificationLanguage CustomerEmailLanguage @default(ENGLISH)
  createdBy      String
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creator User @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  owner   User @relation("CustomerOwner", fields: [ownerId], references: [id])
  orderNames CustomerOrderName[]
  consignees CustomerConsignee[]
  orders  Order[]
  receipts Receipt[]
  orderTrackers OrderTracker[]
  notificationEmails CustomerNotificationEmail[]
  emailNotifications EmailNotification[]

  @@index([mark])
  @@index([normalizedMark])
  @@index([orderName])
  @@index([ownerId])
}

model CustomerOrderName {
  id                  String   @id @default(cuid())
  customerId          String
  orderName           String   @map("order_name")
  normalizedOrderName String   @map("normalized_order_name")
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, normalizedOrderName])
  @@index([normalizedOrderName])
  @@index([customerId, isPrimary])
}

model CustomerConsignee {
  id                  String   @id @default(cuid())
  customerId          String
  consignee           String   @db.Text
  normalizedConsignee     String   @map("normalized_consignee") @db.Text
  normalizedConsigneeHash String   @map("normalized_consignee_hash")
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, normalizedConsigneeHash])
  @@index([normalizedConsigneeHash])
  @@index([customerId, isPrimary])
}

model CustomerNotificationEmail {
  id              String   @id @default(cuid())
  customerId      String
  email           String   @db.VarChar(320)
  normalizedEmail String   @db.VarChar(320)
  isPrimary       Boolean  @default(false)
  createdBy       String
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User     @relation("CustomerNotificationEmailCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater  User?    @relation("CustomerNotificationEmailUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([customerId, normalizedEmail])
  @@index([customerId, isPrimary])
  @@index([createdBy])
  @@index([updatedBy])
}

model EmailTemplate {
  id                String                    @id @default(cuid())
  type              EmailNotificationType
  language          CustomerEmailLanguage
  version           Int                       @default(1)
  subjectTemplate   String                    @db.Text
  bodyTemplate      String                    @db.LongText
  requiredVariables Json
  isActive          Boolean                   @default(true)
  createdBy         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  creator    User?           @relation("EmailTemplateCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  deliveries EmailDelivery[]

  @@unique([type, language, version])
  @@index([type, language, isActive])
  @@index([createdBy])
}

model EmailNotification {
  id                   String                   @id @default(cuid())
  eventKey             String                   @unique
  type                 EmailNotificationType
  status               EmailNotificationStatus @default(PENDING)
  customerId           String?
  receiptId            String?
  invoiceId            String?
  parentNotificationId String?
  sourceActorId        String?
  currentSnapshot      Json
  correctionReason     String?                  @db.Text
  approvedBy           String?
  approvedAt           DateTime?
  cancelledBy          String?
  cancelledAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  receipt     Receipt?            @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  parent      EmailNotification?  @relation("EmailNotificationCorrections", fields: [parentNotificationId], references: [id], onDelete: SetNull)
  corrections EmailNotification[] @relation("EmailNotificationCorrections")
  sourceActor User?               @relation("EmailNotificationSourceActor", fields: [sourceActorId], references: [id], onDelete: SetNull)
  approver    User?               @relation("EmailNotificationApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  canceller   User?               @relation("EmailNotificationCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  deliveries  EmailDelivery[]

  @@index([status, createdAt])
  @@index([customerId, type])
  @@index([receiptId])
  @@index([invoiceId])
  @@index([parentNotificationId])
  @@index([sourceActorId])
  @@index([approvedBy])
  @@index([cancelledBy])
}

model EmailDelivery {
  id                String                @id @default(cuid())
  notificationId    String
  templateId        String?
  status            EmailDeliveryStatus   @default(QUEUED)
  recipientMode     EmailRecipientMode
  language          CustomerEmailLanguage
  templateVersion   Int
  senderName        String
  senderAddress     String                @db.VarChar(320)
  replyToAddress    String?               @db.VarChar(320)
  intendedTo        Json
  intendedCc        Json
  actualTo          Json
  actualCc          Json
  subject           String                @db.Text
  htmlBody          String                @db.LongText
  textBody          String                @db.LongText
  businessSnapshot  Json
  providerMessageId String?               @unique
  idempotencyKey    String                @unique
  claimToken        String?
  claimExpiresAt    DateTime?
  nextAttemptAt     DateTime?
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?               @db.Text
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  notification EmailNotification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  template     EmailTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  attempts     EmailDeliveryAttempt[]
  webhookEvents EmailWebhookEvent[]

  @@index([status, nextAttemptAt])
  @@index([claimExpiresAt])
  @@index([notificationId])
  @@index([templateId])
}

model EmailDeliveryAttempt {
  id                String             @id @default(cuid())
  deliveryId        String
  attemptNo         Int
  status            EmailAttemptStatus @default(STARTED)
  idempotencyKey    String
  providerMessageId String?
  failureCode       String?
  failureMessage    String?            @db.Text
  responseMetadata  Json?
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?

  delivery EmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNo])
  @@index([status, startedAt])
  @@index([providerMessageId])
}

model EmailWebhookEvent {
  id                String    @id @default(cuid())
  providerEventId   String    @unique
  deliveryId        String?
  providerMessageId String
  eventType         String
  payload           Json
  occurredAt        DateTime
  receivedAt        DateTime  @default(now())
  appliedAt         DateTime?

  delivery EmailDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)

  @@index([providerMessageId, occurredAt])
  @@index([deliveryId])
  @@index([eventType, occurredAt])
}

// ==================== 删除申请表 ====================
model DeletionRequest {
  id           String           @id @default(cuid())
  targetType   DeletionTargetType // 删除目标类型
  targetId     String           // 目标ID
  reason       String?          @db.Text // 删除原因
  status       DeletionStatus   @default(PENDING)
  requestedBy  String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // 关联
  requester User  @relation(fields: [requestedBy], references: [id])
  approver  User? @relation("ApprovedBy", fields: [approvedBy], references: [id])

  @@index([targetType])
  @@index([targetId])
  @@index([status])
}

// ==================== 余额转移记录表 ====================
model BalanceTransfer {
  id              String   @id @default(cuid())
  fromOrderId     String
  toOrderId       String
  generatedReceiptId String? @unique
  amount          Decimal  @db.Decimal(18, 2) // 转移金额
  note            String?  @db.Text // 转移备注
  createdBy       String
  createdAt       DateTime @default(now())

  // 关联
  fromOrder Order @relation("TransferFrom", fields: [fromOrderId], references: [id])
  toOrder   Order @relation("TransferTo", fields: [toOrderId], references: [id])
  generatedReceipt Receipt? @relation("BalanceTransferGeneratedReceipt", fields: [generatedReceiptId], references: [id], onDelete: Restrict)

  @@index([fromOrderId])
  @@index([toOrderId])
}

// ==================== 审计日志表 ====================
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String?
  actorId    String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([targetType, targetId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ==================== 系统配置表 ====================
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updater User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model SystemCounter {
  key       String   @id
  nextValue Int
  updatedAt DateTime @updatedAt
}

model ReceiptGeneratorSession {
  id                    String                        @id @default(cuid())
  receiptId             String?                       @unique
  receiptNo             String
  orderNo               String
  invNo                 String?
  customerId            String?
  customerMark          String?
  customerName          String?
  clientTel             String?
  usd                   Decimal                       @db.Decimal(18, 2)
  balanceBefore         Decimal?                      @db.Decimal(18, 2)
  balanceAfter          Decimal?                      @db.Decimal(18, 2)
  amountInWords         String?                       @db.Text
  motif                 String?                       @db.Text
  receiverSignatureUrl  String?                       @db.LongText
  receiverSignatureName String?                       @db.Text
  payerSignatureUrl     String?                       @db.LongText
  payerSignatureName    String?                       @db.Text
  finalImageUrl         String?                       @db.LongText
  finalImageName        String?                       @db.Text
  layoutSnapshot        Json?
  status                ReceiptGeneratorSessionStatus @default(PENDING)
  createdBy             String
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  receipt Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  creator User     @relation("ReceiptGeneratorSessionCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, createdAt])
  @@index([status, createdAt])
}
