# Local direct run (outside Docker)
DATABASE_URL="mysql://muledger:replace-with-your-password@192.168.1.3:3306/trading_ledger"

# Required in production (at least 32 characters, do not use public placeholders)
SESSION_SECRET=""
TRUST_PROXY_HEADERS="true"

# HTTPS reverse proxy host (set your real domain in production)
CADDY_HOST="localhost"
CADDY_EMAIL=""
CADDY_MAX_REQUEST_BODY_SIZE="10MB"

# Optional admin init route (disabled by default)
ENABLE_INIT_ROUTE="false"
INIT_ADMIN_TOKEN="replace-init-token"
INIT_ADMIN_EMAIL="admin@example.com"
INIT_ADMIN_PASSWORD=""

# OCR resilience and cost logging
OCR_DISABLED="false"
OCR_API_BASE_URL="https://api.openai.com/v1"
OCR_API_KEY="replace-with-your-ocr-api-key"
OCR_MODEL="gpt-4o-mini"
OCR_MAX_RETRIES="3"
OCR_TIMEOUT_MS="60000"
OCR_RETRY_BASE_DELAY_MS="1200"
OCR_INPUT_COST_PER_1K="0"
OCR_OUTPUT_COST_PER_1K="0"

# Optional Dashboard customer analytics defaults.
# ADMIN-saved SystemSetting values take precedence after configuration is saved.
CUSTOMER_ANALYTICS_LOOKBACK_MONTHS="12"
CUSTOMER_ANALYTICS_NORMAL_DAYS="30"
CUSTOMER_ANALYTICS_MILD_DELAY_DAYS="60"
CUSTOMER_ANALYTICS_DELAY_DAYS="90"
CUSTOMER_ANALYTICS_WARNING_DAYS="120"
CUSTOMER_ANALYTICS_DOUBLE_WARNING_DAYS="150"
CUSTOMER_ANALYTICS_SEVERE_WARNING_DAYS="180"

# App-layer body size guardrails
JSON_BODY_MAX_BYTES="262144"
UPLOAD_BODY_MAX_BYTES="10485760"

# Internal maintenance loop for uploaded asset cleanup
MAINTENANCE_JOB_TOKEN=""
MAINTENANCE_BASE_URL="http://app:3000"
MAINTENANCE_LOOP_SECONDS="86400"
UPLOADED_ASSET_STAGED_TTL_HOURS="24"
SIGNING_PENDING_TTL_HOURS="72"

# Host-side NAS mount for uploaded business images
UPLOAD_HOST_DIR="/Volumes/团队文件-DAINTY_SHIPMENT/docker/trading-ledger-system/upload"
