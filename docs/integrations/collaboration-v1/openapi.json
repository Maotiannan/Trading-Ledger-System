{
  "openapi": "3.1.0",
  "info": {
    "title": "MuLedger Collaboration Credit Records",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://muledger.example.invalid",
      "description": "Replace with authorized Ledger server URL; no browser access"
    }
  ],
  "security": [
    {
      "collaborationCreditRead": []
    }
  ],
  "components": {
    "securitySchemes": {
      "collaborationCreditRead": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent server-only credential. Fixed scope credit-records:read."
      }
    }
  },
  "paths": {
    "/api/integrations/collaboration/v1/credit-records": {
      "get": {
        "operationId": "listCreditRecords",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 20
            },
            "description": "Capped to 50"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current source records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/page"
                }
              }
            }
          },
          "400": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "401": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "404": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "405": {
            "description": "GET only; framework response may be empty"
          },
          "429": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "503": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/integrations/collaboration/v1/credit-records/{creditRecordId}": {
      "get": {
        "operationId": "readCreditRecord",
        "parameters": [
          {
            "name": "creditRecordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current source records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/creditRecord"
                }
              }
            }
          },
          "400": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "401": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "404": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "405": {
            "description": "GET only; framework response may be empty"
          },
          "429": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          },
          "503": {
            "description": "See README error codes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./credit-records.schema.json#/definitions/error"
                }
              }
            }
          }
        }
      }
    }
  }
}
